# ===== Django =====
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-secreta
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ===== Base de datos =====
# Corriendo con 'python manage.py runserver' en tu maquina -> SQLite
DATABASE_URL=sqlite:///db.sqlite3
# Corriendo dentro de Docker -> PostgreSQL (el host 'db' es el nombre del servicio)
# DATABASE_URL=postgres://postgres:postgres@db:5432/globalexchange

# ===== Keycloak / OIDC =====
# OJO: el navegador tiene que poder abrir esta URL, por eso en desarrollo
# local va 'localhost'. El nombre 'keycloak' solo existe dentro de Docker.
KEYCLOAK_SERVER_URL=http://localhost:8080
# Corriendo dentro de Docker: http://keycloak:8080
# Solo hace falta dentro de Docker: KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=global-exchange
OIDC_RP_CLIENT_ID=global-exchange-web
OIDC_RP_CLIENT_SECRET=cambia-esto
# Cliente técnico para RF011. Lo completa scripts/sincronizar_secret.py.
KEYCLOAK_ADMIN_CLIENT_ID=global-exchange-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=cambia-esto

# ===== Email (verificación de correo) =====
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
