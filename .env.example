# ===== Django =====
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-secreta
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ===== Base de datos =====
# Con Docker (lo normal en este proyecto). El host 'db' es el nombre del servicio.
DATABASE_URL=postgres://postgres:postgres@db:5432/globalexchange
# Corriendo Django fuera de Docker: DATABASE_URL=sqlite:///db.sqlite3

# ===== Keycloak / OIDC =====
# OJO: el navegador tiene que poder abrir esta URL, por eso en desarrollo
# local va 'localhost'. El nombre 'keycloak' solo existe dentro de Docker.
KEYCLOAK_SERVER_URL=http://localhost:8080
# Corriendo dentro de Docker: http://keycloak:8080
# Solo hace falta dentro de Docker: KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=global-exchange
OIDC_RP_CLIENT_ID=global-exchange-web
OIDC_RP_CLIENT_SECRET=cambia-esto
# Cliente técnico para RF011. Lo completa scripts/sincronizar_secret.py.
KEYCLOAK_ADMIN_CLIENT_ID=global-exchange-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=cambia-esto

# ===== Email (verificación de correo) =====
# Lo usan Django (producción) y Keycloak (correos de verificación).
# Si EMAIL_HOST queda VACÍO, Keycloak usa Mailpit: un buzón falso que atrapa
# los correos en http://localhost:8025 y no manda nada a internet (desarrollo).
# Para que lleguen a usuarios reales, completá los datos de tu proveedor.
#
# Gmail: hace falta la verificación en dos pasos activada y una
# "contraseña de aplicación" (Google no acepta la contraseña normal).
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=tucuenta@gmail.com
#   EMAIL_HOST_PASSWORD=la-contraseña-de-aplicación-de-16-letras
#   EMAIL_FROM=tucuenta@gmail.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Dirección que verá el usuario como remitente (en Gmail debe ser la misma cuenta)
EMAIL_FROM=
EMAIL_FROM_NAME=Global Exchange

# ===== API dLocal (RF022) =====
# "simulado" no llama a ningún servicio externo (demos y tests sin red).
# "dlocal" sí llama de verdad al sandbox — necesita las tres claves de abajo.
PAGO_PROVEEDOR=simulado
DLOCAL_X_LOGIN=pegá_acá_el_x-login
DLOCAL_X_TRANS_KEY=pegá_acá_el_x-trans-key
DLOCAL_SECRET_KEY=pegá_acá_la_secret_key
DLOCAL_BASE_URL=https://sandbox.dlocal.com

# ===== API Factura Segura (RF026) =====
# "simulado" no llama a ningún servicio externo (desarrollo, demo y tests).
# "facturasegura" sí llama al ambiente de pruebas — necesita el token.
# El token se genera UNA vez por ambiente con usuario y contraseña:
#   curl -X POST https://apitest.facturasegura.com.py/login?include_auth_token \
#     -H "Content-Type: application/json" \
#     -d '{"email":"...","password":"..."}'
# y sale en user.authentication_token. Nunca se versiona ni se escribe en logs.
FACTURACION_PROVEEDOR=simulado
FACTURASEGURA_BASE_URL=https://apitest.facturasegura.com.py/misife00/v1/esi
FACTURASEGURA_TOKEN=
# Numeración del documento (dEst / dPunExp del SIFEN) y el rango de números
# que la cátedra autorizó para ese punto de expedición. Un dNumDoc fuera del
# rango lo rechaza el SIFEN. HASTA vacío o 0 = sin límite.
FACTURACION_ESTABLECIMIENTO=001
FACTURACION_PUNTO_EXPEDICION=001
FACTURACION_NUMERO_DESDE=
FACTURACION_NUMERO_HASTA=
# Datos del emisor. Los reales dependen del emisor que la cátedra asocie al
# usuario ESI; mientras estén vacíos, config/settings/base.py usa valores de
# prueba que NO sirven ante el SIFEN.
FACTURACION_TIMBRADO=
FACTURACION_TIMBRADO_INICIO=
FACTURACION_EMISOR_RUC=
FACTURACION_EMISOR_DV=
FACTURACION_EMISOR_TIPO_CONTRIBUYENTE=
FACTURACION_EMISOR_NOMBRE=
FACTURACION_EMISOR_DIRECCION=
FACTURACION_EMISOR_NUMERO_CASA=
FACTURACION_EMISOR_DEPARTAMENTO=
FACTURACION_EMISOR_DEPARTAMENTO_NOMBRE=
FACTURACION_EMISOR_CIUDAD=
FACTURACION_EMISOR_CIUDAD_NOMBRE=
FACTURACION_EMISOR_TELEFONO=
FACTURACION_EMISOR_EMAIL=
# Actividades económicas: "codigo:descripcion", separadas por "|".
FACTURACION_EMISOR_ACTIVIDADES=