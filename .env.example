# El script deploy.sh genera los secretos de desarrollo la primera vez.
DJANGO_SECRET_KEY=GENERATE_ON_DEPLOY
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL de Django y Keycloak
POSTGRES_DB=globalexchange
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GENERATE_ON_DEPLOY
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=GENERATE_ON_DEPLOY
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=GENERATE_ON_DEPLOY
DATABASE_URL=GENERATE_ON_DEPLOY

# Keycloak / OIDC
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=global-exchange
OIDC_RP_CLIENT_ID=global-exchange-web
OIDC_RP_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_ID=global-exchange-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Correo. Sin credenciales Keycloak usa Mailpit en desarrollo.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Global Exchange

# API dLocal
PAGO_PROVEEDOR=simulado
DLOCAL_X_LOGIN=
DLOCAL_X_TRANS_KEY=
DLOCAL_SECRET_KEY=
DLOCAL_BASE_URL=https://sandbox.dlocal.com

