# ===== Django =====
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-secreta
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ===== Base de datos (PostgreSQL dentro de Docker) =====
DATABASE_URL=postgres://postgres:postgres@db:5432/globalexchange

# ===== Keycloak / OIDC =====
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=global-exchange
OIDC_RP_CLIENT_ID=global-exchange-web
OIDC_RP_CLIENT_SECRET=cambia-esto

# ===== Email (verificación de correo) =====
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
