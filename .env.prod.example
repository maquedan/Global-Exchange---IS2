# ==========================================
# 1. BASE DE DATOS PRINCIPAL (Django)
# ==========================================
POSTGRES_DB=globalexchange
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_contrasena_segura_db_django

# Configuración de conexión de Django a la BD
DATABASE_URL=postgres://postgres:tu_contrasena_segura_db_django@db:5432/globalexchange

# ==========================================
# 2. BASE DE DATOS DE KEYCLOAK
# ==========================================
KEYCLOAK_DB_PASSWORD=tu_contrasena_segura_db_keycloak

# ==========================================
# 3. KEYCLOAK ADMIN & HOST
# ==========================================
KC_ADMIN_USER=admin_prod
KC_ADMIN_PASSWORD=contrasena_super_segura_admin_kc

# URL pública de Keycloak, accesible desde el navegador.
KEYCLOAK_PUBLIC_URL=https://auth.tu-dominio.com
KEYCLOAK_SERVER_URL=https://auth.tu-dominio.com
# URL interna que usa Django para comunicarse con Keycloak.
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

# ==========================================
# 4. CONFIGURACIÓN DE DJANGO (PRODUCCIÓN)
# ==========================================
# Genera una clave secreta fuerte para Django
SECRET_KEY=cambia_esta_clave_por_una_cadena_larga_y_aleatoria

# Modo Debug desactivado para producción
DEBUG=False

# URL pública de la aplicación Django, sin ruta final.
# En producción real, usa HTTPS y el dominio publicado.
APP_PUBLIC_URL=https://tu-dominio.com

# Hosts permitidos por Django (separados por coma)
DJANGO_ALLOWED_HOSTS=tu-dominio.com,192.168.1.100,localhost

# Configuración para Keycloak dentro de Django
KEYCLOAK_CLIENT_ID=global-exchange-client
KEYCLOAK_CLIENT_SECRET=tu_client_secret_de_keycloak