# Copiá este archivo a .env.prod y reemplazá todos los valores REEMPLAZAR.
# No compartas ni subas .env.prod al repositorio.

# PostgreSQL de Django
POSTGRES_DB=globalexchange
POSTGRES_USER=globalexchange
POSTGRES_PASSWORD=REEMPLAZAR_POR_UN_SECRETO
DATABASE_URL=postgres://globalexchange:REEMPLAZAR_POR_UN_SECRETO@db:5432/globalexchange

# PostgreSQL de Keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=REEMPLAZAR_POR_UN_SECRETO

# Administrador inicial de Keycloak
KC_ADMIN_USER=REEMPLAZAR
KC_ADMIN_PASSWORD=REEMPLAZAR_POR_UN_SECRETO

# Django y OIDC
SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_ALLOWED_HOSTS=tu-dominio.com
OIDC_RP_CLIENT_ID=global-exchange-web
OIDC_RP_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_ID=global-exchange-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_REALM=global-exchange

# URLs públicas (sin barra final) e internas
APP_PUBLIC_URL=https://tu-dominio.com
SITE_BASE_URL=https://tu-dominio.com
KEYCLOAK_PUBLIC_URL=https://auth.tu-dominio.com
KEYCLOAK_SERVER_URL=https://auth.tu-dominio.com
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

# Seguridad detrás de HTTPS
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_COOKIE_SECURE=True
DJANGO_HSTS_SECONDS=31536000

# Correo y pagos: completa solo si se habilitan en producción
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Global Exchange
PAGO_PROVEEDOR=simulado
DLOCAL_X_LOGIN=
DLOCAL_X_TRANS_KEY=
DLOCAL_SECRET_KEY=
DLOCAL_BASE_URL=https://sandbox.dlocal.com
